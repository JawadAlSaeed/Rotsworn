[gd_resource type="Resource" script_class="GlossaryData" format=3]

[ext_resource type="Script" path="res://scripts/data/glossary_entry.gd" id="1_d4656"]
[ext_resource type="Script" path="res://scripts/data/glossary_data.gd" id="2_633y8"]

[sub_resource type="Resource" id="Resource_4pvst"]
script = ExtResource("1_d4656")
id = "turn_order"
topic = "fight"
term = "Turn order"
text = "The row of portraits at the top shows who acts next. Speed decides it, so a quick enemy can act twice before a slow hero acts once."

[sub_resource type="Resource" id="Resource_hd6qm"]
script = ExtResource("1_d4656")
id = "basic_attack"
topic = "fight"
term = "Attack"
text = "Always on the menu and always gives 1 AP. Press its ring for a bonus. Save your AP for skills."

[sub_resource type="Resource" id="Resource_fpscn"]
script = ExtResource("1_d4656")
id = "first_strike"
topic = "fight"
term = "First strike"
text = "In a zone, hit a roaming enemy before it touches you. Your whole party then acts before any enemy in that fight."
tag = "FIRST STRIKE!"
color = Color(1, 0.82, 0.3, 1)

[sub_resource type="Resource" id="Resource_tb6tb"]
script = ExtResource("1_d4656")
id = "run_away"
topic = "fight"
term = "Running away"
text = "Hold the Run button until its ring fills, then make one slow press. Only a PERFECT press gets that hero out. Not against bosses, guards, elites or ambushes."

[sub_resource type="Resource" id="Resource_03a7d"]
script = ExtResource("1_d4656")
id = "downed"
topic = "fight"
term = "Downed"
text = "At 0 HP a hero is downed: no turns, cannot be targeted. Revive, Smelling Salts and the Team Ultimate bring them back. All three down ends the run."

[sub_resource type="Resource" id="Resource_e1ac5"]
script = ExtResource("1_d4656")
id = "fight_items"
topic = "fight"
term = "Items in a fight"
text = "The Items button lists the backpack's usable things. Using one is the hero's action and costs AP. Used items are gone when the fight ends."

[sub_resource type="Resource" id="Resource_4h0w4"]
script = ExtResource("1_d4656")
id = "whole_party"
topic = "fight"
term = "Whole party"
text = "The sign says WHOLE PARTY when an attack hits every hero. Every hero defends. If all of them defend perfectly, you strike back together."
tag = "WHOLE PARTY"

[sub_resource type="Resource" id="Resource_8w76o"]
script = ExtResource("1_d4656")
id = "hit_normal"
topic = "reading"
term = "Normal hit"
text = "A plain strike, drawn as a sword. Parry it or dodge it. A parry earns AP and keeps a counter alive; a dodge only saves you the damage."
icon_path = "res://assets/sprites/ui/hit_normal.png"
color = Color(1, 0.3, 0.2, 1)

[sub_resource type="Resource" id="Resource_gng8j"]
script = ExtResource("1_d4656")
id = "hit_ground"
topic = "reading"
term = "Ground hit"
text = "A shockwave or rock spikes along the floor, with a purple glow under you. Only a jump avoids it. A dodge or a parry fails."
icon_path = "res://assets/sprites/ui/hit_ground.png"
color = Color(0.78, 0.4, 1, 1)

[sub_resource type="Resource" id="Resource_o85np"]
script = ExtResource("1_d4656")
id = "hit_rend"
topic = "reading"
term = "Rend"
text = "Bone-coloured claw marks. Only a parry stops it; a dodge or a jump fails. Rends come in hard fights."
tag = "MUST PARRY"
icon_path = "res://assets/sprites/ui/hit_rend.png"
color = Color(0.96, 0.86, 0.58, 1)

[sub_resource type="Resource" id="Resource_lgwoi"]
script = ExtResource("1_d4656")
id = "hit_sweep"
topic = "reading"
term = "Sweep"
text = "A green crescent. Only a dodge avoids it. A sweep has no perfect answer, so an attack with a sweep in it can never be countered."
tag = "MUST DODGE"
icon_path = "res://assets/sprites/ui/hit_sweep.png"
color = Color(0.6, 0.86, 0.22, 1)

[sub_resource type="Resource" id="Resource_fckk8"]
script = ExtResource("1_d4656")
id = "feint"
topic = "reading"
term = "Feint"
text = "A hit wearing a dashed orange ring. The enemy lunges, stops, holds, then really strikes. Wait for the real lunge."
color = Color(1, 0.6, 0.15, 1)

[sub_resource type="Resource" id="Resource_0tpnu"]
script = ExtResource("1_d4656")
id = "thrown"
topic = "reading"
term = "Thrown hit"
text = "Spit, stones and bolts, drawn as a steel ball with speed lines. The enemy throws from where it stands. It is still a normal hit: parry or dodge it as it arrives."
icon_path = "res://assets/sprites/ui/hit_ranged.png"
color = Color(1, 0.3, 0.2, 1)

[sub_resource type="Resource" id="Resource_7jpox"]
script = ExtResource("1_d4656")
id = "intent_sign"
topic = "reading"
term = "The sign"
text = "The sign under an enemy shows its next attack: name, who it targets and one icon per hit, spaced like the real rhythm. After the first hit lands, the icons hide."

[sub_resource type="Resource" id="Resource_8pdof"]
script = ExtResource("1_d4656")
id = "each_in_turn"
topic = "reading"
term = "Each in turn"
text = "Some attacks strike one hero per hit, in the order the sign shows (SWARM ROUND -> CASS > ALDER > BRIN). In co-op each player defends their own hits."

[sub_resource type="Resource" id="Resource_vatr1"]
script = ExtResource("1_d4656")
id = "marking_hit"
topic = "reading"
term = "Marking hit"
text = "A hit with a small coloured dot carries a mark. The sign adds [ROT], [BLIGHT], [WEAK] or [AP DRAIN]. It lands only if you fail to defend that hit and survive it."
tag = "[ROT]"
color = Color(0.68, 0.86, 0.22, 1)

[sub_resource type="Resource" id="Resource_4ue4x"]
script = ExtResource("1_d4656")
id = "parry"
topic = "defence"
term = "Parry"
text = "Press as the hit lands. It stops normal hits and rends, and earns 1 AP. Parry every hit of an attack and that hero strikes back. The tightest timing."
tag = "PARRY"
color = Color(1, 0.95, 0.55, 1)

[sub_resource type="Resource" id="Resource_ney2o"]
script = ExtResource("1_d4656")
id = "dodge"
topic = "defence"
term = "Dodge"
text = "Stops normal hits and sweeps, and is the most forgiving timing. It earns nothing and cannot answer a rend or a ground hit."
tag = "DODGE"
color = Color(0.62, 1, 0.7, 1)

[sub_resource type="Resource" id="Resource_rq2lu"]
script = ExtResource("1_d4656")
id = "jump"
topic = "defence"
term = "Jump"
text = "The only answer to a ground hit. Jump as the wave arrives; jumping into a normal hit fails. A jump counts as a perfect defence for counters."
tag = "JUMP"
color = Color(0.55, 0.88, 1, 1)

[sub_resource type="Resource" id="Resource_0sw3m"]
script = ExtResource("1_d4656")
id = "wrong_button"
topic = "defence"
term = "Wrong button"
text = "Pressing the wrong defence still lets the hit land. The orange hint says which one it wanted: MUST PARRY on a rend, MUST DODGE on a sweep."
tag = "JUMP!"
color = Color(1, 0.6, 0.15, 1)

[sub_resource type="Resource" id="Resource_ym7ni"]
script = ExtResource("1_d4656")
id = "early"
topic = "defence"
term = "EARLY"
text = "You pressed before the window opened. It shows how many milliseconds early, counts as a whiff, and locks your defence buttons for a moment."
tag = "EARLY"
color = Color(0.38, 0.62, 1, 1)

[sub_resource type="Resource" id="Resource_hqq7o"]
script = ExtResource("1_d4656")
id = "late"
topic = "defence"
term = "LATE"
text = "You pressed after the window closed, and the hit landed. It shows how many milliseconds late. Like EARLY it is a whiff."
tag = "LATE"
color = Color(1, 0.36, 0.3, 1)

[sub_resource type="Resource" id="Resource_0k6kt"]
script = ExtResource("1_d4656")
id = "lockout"
topic = "defence"
term = "Lockout"
text = "A press that matches nothing locks your defence buttons, and pressing while locked restarts the lock. Mashing never works: one calm press per hit."
icon_path = "res://assets/sprites/ui/lock.png"

[sub_resource type="Resource" id="Resource_b1y1j"]
script = ExtResource("1_d4656")
id = "no_press"
topic = "defence"
term = "MISS (defence)"
text = "If you press nothing for a hit, it lands and MISS shows. A single miss costs only that hit, so keep calm and read the next one."
tag = "MISS"
color = Color(0.86, 0.86, 0.86, 1)

[sub_resource type="Resource" id="Resource_yh8rg"]
script = ExtResource("1_d4656")
id = "ap"
topic = "skills"
term = "AP"
text = "Action points, the blue pips under each hero. Skills cost AP. Attacks, parries and some skills give it. Each hero has their own, up to 9."
icon_path = "res://assets/sprites/ui/ap_pip.png"
color = Color(0.55, 0.88, 1, 1)

[sub_resource type="Resource" id="Resource_tdm13"]
script = ExtResource("1_d4656")
id = "skill_press"
topic = "skills"
term = "Skill press"
text = "Every skill has a ring to press as it closes, one per hit. How close you press decides PERFECT, GOOD or MISS for that hit."

[sub_resource type="Resource" id="Resource_ygdo2"]
script = ExtResource("1_d4656")
id = "press_perfect"
topic = "skills"
term = "PERFECT"
text = "Pressed in the narrow gold band: extra damage, and if every press of the skill is PERFECT, the skill's bonus too."
tag = "PERFECT"
color = Color(1, 0.82, 0.3, 1)

[sub_resource type="Resource" id="Resource_jrthy"]
script = ExtResource("1_d4656")
id = "press_good"
topic = "skills"
term = "GOOD"
text = "Pressed inside the wider ring: normal damage, and the skill still works in full. It is also enough to start a follow-up."
tag = "GOOD"
color = Color(0.95, 0.94, 0.9, 1)

[sub_resource type="Resource" id="Resource_p048w"]
script = ExtResource("1_d4656")
id = "press_miss"
topic = "skills"
term = "MISS"
text = "Too early, too late or no press: the hit still lands, but for half damage. A press that is too early uses that ring up."
tag = "MISS"
color = Color(0.86, 0.86, 0.86, 1)

[sub_resource type="Resource" id="Resource_wdupp"]
script = ExtResource("1_d4656")
id = "follow_up"
topic = "skills"
term = "Follow-up strike"
text = "When a hero's skill lands, the others get a quick press. GOOD adds a small hit, PERFECT a bigger one, and both fill the team gauge. A miss does nothing."

[sub_resource type="Resource" id="Resource_vvnsa"]
script = ExtResource("1_d4656")
id = "critical"
topic = "skills"
term = "Critical hit"
text = "A lucky hit for 150% damage, shown big and gold. Every hero has a small chance; Luck and some gear raise it. Enemies never crit."
tag = "CRITICAL!"
color = Color(1, 0.82, 0.3, 1)

[sub_resource type="Resource" id="Resource_uf6lj"]
script = ExtResource("1_d4656")
id = "skill_tree"
topic = "skills"
term = "Skill tree"
text = "Each hero has three branches. The top skill of each is known from the start; deeper ones cost skill points. A hero brings five known skills into a fight."

[sub_resource type="Resource" id="Resource_86rir"]
script = ExtResource("1_d4656")
id = "counter"
topic = "team"
term = "Counter"
text = "Defend every hit of an attack perfectly (parries, and jumps on ground hits) and that hero strikes back hard. One dodge or one mistake and there is none."
tag = "COUNTER!"
color = Color(1, 0.82, 0.3, 1)

[sub_resource type="Resource" id="Resource_g3uas"]
script = ExtResource("1_d4656")
id = "counter_chain"
topic = "team"
term = "Longer strings"
text = "Every extra perfect hit in one attack makes the counter stronger, and mixing parries with jumps adds a bonus. The text says why: COUNTER x5, MIXED."
tag = "COUNTER x5!"
color = Color(1, 0.82, 0.3, 1)

[sub_resource type="Resource" id="Resource_1kck3"]
script = ExtResource("1_d4656")
id = "team_counter"
topic = "team"
term = "Team counter"
text = "When an attack hits the whole party and every hero defends every hit perfectly, you all strike as one. Heroes who fell cannot join."
tag = "TEAM COUNTER!"
color = Color(1, 0.82, 0.3, 1)

[sub_resource type="Resource" id="Resource_g886g"]
script = ExtResource("1_d4656")
id = "team_gauge"
topic = "team"
term = "Team gauge"
text = "Fills when follow-ups land, with some skills and with a defence streak. In a run it carries over to the next fight. When it is full the Team Ultimate is ready."
color = Color(0.95, 0.62, 0.2, 1)

[sub_resource type="Resource" id="Resource_p24streak"]
script = ExtResource("1_d4656")
id = "defence_streak"
topic = "team"
term = "Defence streak"
text = "Perfect parries and jumps in a row, by the whole party, across the fight. Every 5 add to the team gauge and the music swells. A dodge keeps it; a hit ends it."
tag = "STREAK"
color = Color(1, 0.82, 0.3, 1)

[sub_resource type="Resource" id="Resource_hl2di"]
script = ExtResource("1_d4656")
id = "team_ultimate"
topic = "team"
term = "Team Ultimate"
text = "With a full gauge, any hero can call it on their turn. All heroes strike together for big damage and downed allies stand up again. It costs no AP."
color = Color(0.95, 0.62, 0.2, 1)

[sub_resource type="Resource" id="Resource_fmp8d"]
script = ExtResource("1_d4656")
id = "taunt"
topic = "team"
term = "Taunt"
text = "Alder's Taunt forces the enemy's next single-target attack onto him. He then parries it and counters, so it is how a tank is made."
tag = "TAUNTED"
color = Color(1, 0.4, 0.4, 1)

[sub_resource type="Resource" id="Resource_qwexe"]
script = ExtResource("1_d4656")
id = "status_exposed"
topic = "foe_marks"
term = "Exposed"
text = "Cass's Reveal leaves it. The next damaging skill on that enemy removes it for 50% more damage (Rend: 150% more). It does not stack."
tag = "EXPOSED"
color = Color(1, 0.55, 0.3, 1)

[sub_resource type="Resource" id="Resource_870e2"]
script = ExtResource("1_d4656")
id = "status_marked"
topic = "foe_marks"
term = "Marked"
text = "Brin's Death Mark. The next few damaging skills on that one enemy deal 40% more, and each skill that lands uses one up."
tag = "MARKED"
color = Color(1, 0.3, 0.7, 1)

[sub_resource type="Resource" id="Resource_ifc33"]
script = ExtResource("1_d4656")
id = "status_bleeding"
topic = "foe_marks"
term = "Bleeding"
text = "At the start of each of its turns the enemy loses a share of the hero's power, for a few turns. Weakened heroes make it bleed less."
tag = "BLEEDING"
color = Color(0.9, 0.2, 0.25, 1)

[sub_resource type="Resource" id="Resource_ntj47"]
script = ExtResource("1_d4656")
id = "status_slowed"
topic = "foe_marks"
term = "Slowed"
text = "Its turns come later. Hamstring slows an enemy, so your party acts more between its attacks; a toad's mud or a shade's cold slows a hero the same way."
tag = "SLOWED"
icon_path = "res://assets/sprites/ui/mark_slowed.png"
color = Color(0.7, 0.6, 1, 1)

[sub_resource type="Resource" id="Resource_jp5hm"]
script = ExtResource("1_d4656")
id = "status_shielded"
topic = "foe_marks"
term = "Shielded"
text = "A Rot Priest's ward on a fellow monster: it takes much less damage for a few of its turns. Kill the priest first, or hit someone else."
tag = "SHIELD"
icon_path = "res://assets/sprites/ui/mark_shielded.png"
color = Color(0.62, 0.86, 0.92, 1)

[sub_resource type="Resource" id="Resource_e3swq"]
script = ExtResource("1_d4656")
id = "mark"
topic = "hero_marks"
term = "Marks"
text = "A hit with a coloured dot leaves its mark if you fail to defend it. In a run they start after the first zone; elites, guards and bosses mark everywhere. Defend the dot!"

[sub_resource type="Resource" id="Resource_g3g5a"]
script = ExtResource("1_d4656")
id = "status_rotting"
topic = "hero_marks"
term = "Rot"
text = "At the start of each of the hero's turns they lose a share of max HP, though never below 1 HP from rot alone. It counts down."
tag = "ROT"
icon_path = "res://assets/sprites/ui/mark_rotting.png"
color = Color(0.68, 0.86, 0.22, 1)

[sub_resource type="Resource" id="Resource_kg24a"]
script = ExtResource("1_d4656")
id = "status_burning"
topic = "hero_marks"
term = "Burn"
text = "Fire: at the start of each of the hero's turns they lose a big share of max HP, for fewer turns than rot. Never below 1 HP from fire alone."
tag = "BURN"
icon_path = "res://assets/sprites/ui/mark_burning.png"
color = Color(1, 0.5, 0.18, 1)

[sub_resource type="Resource" id="Resource_l8ilw"]
script = ExtResource("1_d4656")
id = "status_shocked"
topic = "hero_marks"
term = "Shock"
text = "The hero's timing windows shrink: parries, dodges, jumps, skill presses and follow-ups all need a sharper press while it lasts."
tag = "SHOCK"
icon_path = "res://assets/sprites/ui/mark_shocked.png"
color = Color(1, 0.95, 0.42, 1)

[sub_resource type="Resource" id="Resource_vd1pi"]
script = ExtResource("1_d4656")
id = "status_dazed"
topic = "hero_marks"
term = "Daze"
text = "The hero loses their next turn. Only big must-parry slams daze, so a parry saves the turn."
tag = "DAZE"
icon_path = "res://assets/sprites/ui/mark_dazed.png"
color = Color(1, 0.68, 0.72, 1)

[sub_resource type="Resource" id="Resource_h4eme"]
script = ExtResource("1_d4656")
id = "status_hushed"
topic = "hero_marks"
term = "Hush"
text = "The hero can use no skills, only Attack, items, Run and the team ultimate, until it wears off."
tag = "HUSH"
icon_path = "res://assets/sprites/ui/mark_hushed.png"
color = Color(0.52, 0.58, 0.95, 1)

[sub_resource type="Resource" id="Resource_1f42n"]
script = ExtResource("1_d4656")
id = "status_blighted"
topic = "hero_marks"
term = "Blight"
text = "Healing the hero receives is cut in half for a few turns. Skills, Renew, items and gear all count."
tag = "BLIGHT"
icon_path = "res://assets/sprites/ui/mark_blighted.png"
color = Color(0.82, 0.45, 0.88, 1)

[sub_resource type="Resource" id="Resource_vqib0"]
script = ExtResource("1_d4656")
id = "status_weakened"
topic = "hero_marks"
term = "Weakened"
text = "The hero's power is cut by a quarter for a few turns: skills, follow-ups, counters and the bleed they cause."
tag = "WEAK"
icon_path = "res://assets/sprites/ui/mark_weakened.png"
color = Color(0.72, 0.74, 0.84, 1)

[sub_resource type="Resource" id="Resource_akq8o"]
script = ExtResource("1_d4656")
id = "ap_drain"
topic = "hero_marks"
term = "AP drain"
text = "A hit that drains takes AP from the hero when you fail to defend it. They never go below 0, but a planned skill may become too dear."
tag = "AP DRAIN"
color = Color(0.55, 0.88, 1, 1)

[sub_resource type="Resource" id="Resource_bgl7y"]
script = ExtResource("1_d4656")
id = "cleanse"
topic = "hero_marks"
term = "Cleanse"
text = "Mend and Sanctuary lift one mark, every mark on a PERFECT press. Purify lifts them all. A Salve lifts one, an Antidote all of one hero's, Holy Water everyone's. Marks end with the fight."

[sub_resource type="Resource" id="Resource_e5dtf"]
script = ExtResource("1_d4656")
id = "status_warded"
topic = "hero_help"
term = "Ward"
text = "Cass's Purify: no mark can land on the hero for a few of their turns. Some Relics ward a hero at the start of a fight."
tag = "WARD"
icon_path = "res://assets/sprites/ui/mark_warded.png"
color = Color(0.96, 0.94, 0.72, 1)

[sub_resource type="Resource" id="Resource_87ady"]
script = ExtResource("1_d4656")
id = "status_guarded"
topic = "hero_help"
term = "Guarded"
text = "A guarded hero takes half damage until their next turn. Alder's Guard and Shield Wall give it."
tag = "GUARD"
color = Color(0.55, 0.8, 1, 1)

[sub_resource type="Resource" id="Resource_f2ok5"]
script = ExtResource("1_d4656")
id = "status_riposte"
topic = "hero_help"
term = "Riposte"
text = "Alder's Riposte Stance: until his next turn his counters hit twice as hard."
tag = "RIPOSTE"
color = Color(1, 0.85, 0.35, 1)

[sub_resource type="Resource" id="Resource_q6jq4"]
script = ExtResource("1_d4656")
id = "status_regen"
topic = "hero_help"
term = "Renew"
text = "Cass's Renew heals the hero a share of max HP at the start of each of their turns, for a few turns."
tag = "RENEW"
color = Color(0.45, 1, 0.5, 1)

[sub_resource type="Resource" id="Resource_2nuks"]
script = ExtResource("1_d4656")
id = "status_empowered"
topic = "hero_help"
term = "Empowered"
text = "The hero's next damaging skill on an enemy deals 30% more, then the bonus is gone."
tag = "EMPOWERED"
color = Color(1, 0.75, 0.3, 1)

[sub_resource type="Resource" id="Resource_to4cp"]
script = ExtResource("1_d4656")
id = "doom"
topic = "dooms"
term = "Doom"
text = "A huge party-wide string that a guard or boss announces ahead of time. It gathers for a few of its turns, then unleashes. The sign counts the turns down."
tag = "DOOM 2"
color = Color(1, 0.3, 0.25, 1)

[sub_resource type="Resource" id="Resource_j1o2r"]
script = ExtResource("1_d4656")
id = "break"
topic = "dooms"
term = "Break"
text = "While a Doom gathers, all the damage the party deals fills its BREAK bar. Fill it and the Doom is cancelled. Skills, counters and bleed all count."
tag = "BREAK"
color = Color(1, 0.82, 0.3, 1)

[sub_resource type="Resource" id="Resource_03k8o"]
script = ExtResource("1_d4656")
id = "broken"
topic = "dooms"
term = "Broken"
text = "A broken Doom is cancelled and goes on cooldown. The enemy is staggered and announces a new move at once."
tag = "BROKEN!"
color = Color(1, 0.82, 0.3, 1)

[sub_resource type="Resource" id="Resource_ffvon"]
script = ExtResource("1_d4656")
id = "stagger"
topic = "dooms"
term = "Stagger"
text = "A staggered enemy loses its next turn and takes extra damage from everything until then. TURN LOST shows when the stagger ends."
icon_path = "res://assets/sprites/ui/mark_staggered.png"
color = Color(0.6, 0.85, 1, 1)

[sub_resource type="Resource" id="Resource_t2kkd"]
script = ExtResource("1_d4656")
id = "buying_turns"
topic = "dooms"
term = "Buying turns"
text = "Slowing or pushing back a gathering enemy never cancels its Doom, but it gives your party more turns inside the window to break it."

[sub_resource type="Resource" id="Resource_esrfe"]
script = ExtResource("1_d4656")
id = "roaming"
topic = "enemies"
term = "Roaming enemy"
text = "Seen walking in a zone. Touch one and the fight begins; strike it first for FIRST STRIKE. All but the guard are optional: more gold and XP, more risk."

[sub_resource type="Resource" id="Resource_y6eba"]
script = ExtResource("1_d4656")
id = "elite"
topic = "enemies"
term = "Elite"
text = "A tougher fight: more health, harder hits and better pay, with the hard-fight rends and sweeps. Met on skull stops and as zone champions. You cannot run."
tag = "ELITE"
color = Color(0.85, 0.45, 1, 1)

[sub_resource type="Resource" id="Resource_p8moy"]
script = ExtResource("1_d4656")
id = "guard"
topic = "enemies"
term = "Guard"
text = "Each zone's mini-boss at the far end, with a second phase at half health and a Doom of its own. Beating it clears the zone and gives spoils."
tag = "GUARD"
color = Color(1, 0.82, 0.3, 1)

[sub_resource type="Resource" id="Resource_nw34n"]
script = ExtResource("1_d4656")
id = "champion"
topic = "enemies"
term = "Champion"
text = "An elite that stands still beside a prize chest and never chases you. Beat it and the chest opens with no key. Optional."
tag = "ELITE"
color = Color(0.85, 0.45, 1, 1)

[sub_resource type="Resource" id="Resource_1c0mm"]
script = ExtResource("1_d4656")
id = "boss"
topic = "enemies"
term = "Boss"
text = "An act's last fight: The Husk Lord, then The Hollow King. Its name is announced, it has a second phase and a Doom, and you cannot run."

[sub_resource type="Resource" id="Resource_rjq6c"]
script = ExtResource("1_d4656")
id = "phase_two"
topic = "enemies"
term = "Phase two"
text = "At half health a guard or boss rages: a banner, new attacks and faster strings. It picks a new move at once."

[sub_resource type="Resource" id="Resource_erspk"]
script = ExtResource("1_d4656")
id = "deep_variant"
topic = "enemies"
term = "Deep variant"
text = "A tougher, recoloured kin met in the second half of a run (Ashen Husk, Blight Bloat and so on). Same body, one new move, and rends and sweeps everywhere."

[sub_resource type="Resource" id="Resource_d8cfa"]
script = ExtResource("1_d4656")
id = "hard_fight"
topic = "enemies"
term = "Hard fight"
text = "Elites, guards, bosses and deep variants add forced hits (rends, sweeps and feints) and marks that ordinary early fights do not have."

[sub_resource type="Resource" id="Resource_s1j28"]
script = ExtResource("1_d4656")
id = "depth"
topic = "enemies"
term = "Depth"
text = "Every map row deeper, enemies gain health and power and their strings come faster. The sign still tells the truth about each one."

[sub_resource type="Resource" id="Resource_p2qmn"]
script = ExtResource("1_d4656")
id = "support"
topic = "enemies"
term = "Helpers"
text = "Some monsters help instead of striking: a Rot Priest heals a wounded fellow or shields one. Its sign names the monster it will help. Kill helpers first."
color = Color(0.45, 1, 0.5, 1)

[sub_resource type="Resource" id="Resource_3al64"]
script = ExtResource("1_d4656")
id = "burst"
topic = "enemies"
term = "Burst"
text = "A Pus Tick announces its Burst like a Doom: a few turns later it bursts on the whole party and is gone. Kill it first, or jump the burst."
tag = "DOOM 3"
color = Color(1, 0.3, 0.25, 1)

[sub_resource type="Resource" id="Resource_cu3qc"]
script = ExtResource("1_d4656")
id = "targeting"
topic = "enemies"
term = "Who they pick"
text = "Hunters such as hyenas and shades favour wounded heroes, guards and bosses the weakest. Nobody is ever safe, and Taunt overrides it all."

[sub_resource type="Resource" id="Resource_fbvxs"]
script = ExtResource("1_d4656")
id = "stop_zone"
topic = "map"
term = "Zone stop"
text = "A place to explore, left to right. Beat the guard at the far end to move on. Every other enemy is optional and pays more gold. Each zone stop is a different place."
icon_path = "res://assets/sprites/ui/map_zone_rotten_hollow.png"

[sub_resource type="Resource" id="Resource_s1dhs"]
script = ExtResource("1_d4656")
id = "stop_elite"
topic = "map"
term = "Elite stop"
text = "A skull over crossed blades: one hard fight, then spoils of rare Relics or better, and more gold. The crowned elite's spoils hold a legendary. It cannot be run from."
icon_path = "res://assets/sprites/ui/map_elite.png"

[sub_resource type="Resource" id="Resource_wmbx1"]
script = ExtResource("1_d4656")
id = "stop_event"
topic = "map"
term = "Event stop"
text = "A red question mark: a story with a choice. Every choice has a price, and some turn into a fight. Leave is always there."
icon_path = "res://assets/sprites/ui/map_event.png"

[sub_resource type="Resource" id="Resource_0y7iv"]
script = ExtResource("1_d4656")
id = "stop_treasure"
topic = "map"
term = "Treasure stop"
text = "Two chests, open one. The plain one holds gold and a rare item. The rotten one holds a Relic, but a curse or a fight may come with it."
icon_path = "res://assets/sprites/ui/map_treasure.png"

[sub_resource type="Resource" id="Resource_kghdt"]
script = ExtResource("1_d4656")
id = "stop_rest"
topic = "map"
term = "Campfire stop"
text = "A fire to gather round. Pick one thing: Rest, Train or Upgrade. The campfire before the boss offers Rest, Keep watch (a full team gauge) or Sharpen (+1 AP for the boss fight)."
icon_path = "res://assets/sprites/ui/map_rest.png"

[sub_resource type="Resource" id="Resource_dyfhy"]
script = ExtResource("1_d4656")
id = "stop_shop"
topic = "map"
term = "Shop stop"
text = "The Rag Merchant sells items and Relics, and buys what your pack holds."
icon_path = "res://assets/sprites/ui/map_shop.png"

[sub_resource type="Resource" id="Resource_35qqt"]
script = ExtResource("1_d4656")
id = "stop_lair"
topic = "map"
term = "Boss lair"
text = "The last stop of an act. Beat the boss for spoils and a heal for everyone, then the next act's map opens."
icon_path = "res://assets/sprites/ui/map_lair_husk_lord.png"

[sub_resource type="Resource" id="Resource_vc7d0"]
script = ExtResource("1_d4656")
id = "party_flag"
topic = "map"
term = "Flag and circle"
text = "The flag marks where your party is. A red pen circle marks the stop you have picked; left and right choose the next one."
icon_path = "res://assets/sprites/ui/map_flag.png"

[sub_resource type="Resource" id="Resource_c00ge"]
script = ExtResource("1_d4656")
id = "planning"
topic = "map"
term = "Planning a road"
text = "Once a next stop is picked, every stop and road it cannot lead to fades. Look up the map: a shop or a fire often matters more than one more fight."

[sub_resource type="Resource" id="Resource_lklpv"]
script = ExtResource("1_d4656")
id = "seal"
topic = "zones"
term = "Rot seal"
text = "A glowing standing stone, one in each middle part of a zone, often down a side path or past enemies. Walk up and use Confirm to take it."
icon_path = "res://assets/sprites/env/seal_stone.png"

[sub_resource type="Resource" id="Resource_3r8ir"]
script = ExtResource("1_d4656")
id = "gate"
topic = "zones"
term = "Rot gate"
text = "A wall of rotten roots in front of the guard. It stays shut until the party has two of the zone's three seals."
icon_path = "res://assets/sprites/env/rot_gate.png"

[sub_resource type="Resource" id="Resource_xigk7"]
script = ExtResource("1_d4656")
id = "shrine"
topic = "zones"
term = "Shrine"
text = "Walk up and pray: a yes or no with the price and the gift written out. Springs heal, altars take blood for a find, idols fill the gauge. Each works once."
icon_path = "res://assets/sprites/env/shrine_altar.png"

[sub_resource type="Resource" id="Resource_3yeq3"]
script = ExtResource("1_d4656")
id = "wanderer"
topic = "zones"
term = "Wanderer"
text = "A traveller who turns up in some visits. Talk to them for a deal: the Key Peddler sells keys, the Grave Robber rare finds, the Old Pilgrim heals you for 20 gold."
icon_path = "res://assets/sprites/env/wanderer_peddler.png"

[sub_resource type="Resource" id="Resource_8xwyj"]
script = ExtResource("1_d4656")
id = "glint"
topic = "zones"
term = "Glinting spot"
text = "A sparkle on the ground. Walk up and pick it up for an item or some gold. With no free pocket, the pack opens so you can swap or leave it."
icon_path = "res://assets/sprites/fx/glint.png"

[sub_resource type="Resource" id="Resource_nfl5o"]
script = ExtResource("1_d4656")
id = "chest"
topic = "zones"
term = "Locked chest"
text = "Holds a rare or better prize, and uses up one Key from the backpack. A champion's prize chest needs no key."
icon_path = "res://assets/sprites/env/chest_closed.png"

[sub_resource type="Resource" id="Resource_nokcs"]
script = ExtResource("1_d4656")
id = "shuffled"
topic = "zones"
term = "A new zone each time"
text = "Every visit builds the zone from shuffled parts, so seals, shrines, wanderers and enemies stand somewhere new."

[sub_resource type="Resource" id="Resource_tnp1o"]
script = ExtResource("1_d4656")
id = "gear"
topic = "gear"
term = "Relic"
text = "Kept forever. Worn by one hero in a Relic slot (one at the start of a run, three by act 2): an effect and a small stat. Wear it in won fights to fill its pips and learn its Echo for good."
icon_path = "res://assets/sprites/ui/gear_icon.png"

[sub_resource type="Resource" id="Resource_echo1"]
script = ExtResource("1_d4656")
id = "echo"
topic = "gear"
term = "Echo"
text = "Wear a Relic in won fights to fill its pips, run after run; elites, guards and bosses fill more. Full pips teach its Echo for good: its effect without the stat. One hero wears each Echo, for Echo points from level ups."
tag = "Echo 7/12"
color = Color(0.62, 0.32, 0.72, 1)

[sub_resource type="Resource" id="Resource_rlvl1"]
script = ExtResource("1_d4656")
id = "relic_level"
topic = "gear"
term = "Relic level"
text = "A Relic joins a run at level 1 (Home: found before but left out of the bag). A copy found in the same run raises it, up to level 3, and its stat grows. Levels last one run; a copy past 3 pays gold."
tag = "Lv 2 > 3"
color = Color(1, 0.82, 0.3, 1)

[sub_resource type="Resource" id="Resource_faexo"]
script = ExtResource("1_d4656")
id = "rarity"
topic = "gear"
term = "Rarity"
text = "Grey is common, blue is rare, gold is legendary. Rarer pieces are stronger and cost more, and deeper map rows turn them up more often."
color = Color(1, 0.8, 0.3, 1)

[sub_resource type="Resource" id="Resource_077nu"]
script = ExtResource("1_d4656")
id = "rot_touched"
topic = "gear"
term = "Rot-touched Relic"
text = "A strong Relic with a price: a clear gain and a clear loss, written in plain words. Spoils from elites and bosses offer one. Take it with open eyes."
tag = "rot-touched"
color = Color(0.78, 0.4, 0.95, 1)

[sub_resource type="Resource" id="Resource_osy5s"]
script = ExtResource("1_d4656")
id = "backpack"
topic = "gear"
term = "Pack"
text = "Alder's pack: six pockets, one item each, whatever its shape. A Bigger Pack adds a pocket, up to eight. Open it from the party screen's Bag tab."
icon_path = "res://assets/sprites/items/bigger_pack.png"

[sub_resource type="Resource" id="Resource_m7iqa"]
script = ExtResource("1_d4656")
id = "charm"
topic = "gear"
term = "Charm (gone)"
text = "The old charms are gone since the Relics came: their best ideas became Relics, and the rotten ones became curses."
icon_path = "res://assets/sprites/items/ember_stone.png"

[sub_resource type="Resource" id="Resource_ufadv"]
script = ExtResource("1_d4656")
id = "rotten_item"
topic = "gear"
term = "Curse"
text = "Only hurts: every hero loses a little HP at the start of each of their turns in a fight. It takes a pocket and cannot be sold. A shop's Cleanse, or throwing it away, gets rid of it."
icon_path = "res://assets/sprites/items/rotting_heart.png"
color = Color(0.55, 0.85, 0.3, 1)

[sub_resource type="Resource" id="Resource_wuu7b"]
script = ExtResource("1_d4656")
id = "consumable"
topic = "gear"
term = "Consumable"
text = "Used up. A Salve heals one hero, a Feast the party, a Bomb hurts every enemy, Smelling Salts lift a downed hero, an Antidote or Holy Water lifts marks. In a fight they cost AP."
icon_path = "res://assets/sprites/items/salve.png"

[sub_resource type="Resource" id="Resource_nxshk"]
script = ExtResource("1_d4656")
id = "tonic"
topic = "gear"
term = "Tonic"
text = "Gives one hero more max HP for the rest of the run. A hero can drink only two, and Tonics cannot be combined or upgraded."
icon_path = "res://assets/sprites/items/tonic.png"

[sub_resource type="Resource" id="Resource_7dvlr"]
script = ExtResource("1_d4656")
id = "key_treasure"
topic = "gear"
term = "Keys and treasure"
text = "A Key opens one locked chest. Treasure (rings, gems, idols) turns into gold the moment you find it."
icon_path = "res://assets/sprites/items/key.png"

[sub_resource type="Resource" id="Resource_1pxyj"]
script = ExtResource("1_d4656")
id = "combine"
topic = "gear"
term = "Combine"
text = "Put an item onto the same item at the same level and it goes up a level (Salve+), with a stronger effect. Consumables and charms only."

[sub_resource type="Resource" id="Resource_iobjp"]
script = ExtResource("1_d4656")
id = "shop"
topic = "shops"
term = "The Rag Merchant"
text = "Sells items and Relics for gold, and buys pack items for half their price. The shelves change at every shop."
icon_path = "res://assets/sprites/env/shopkeeper.png"

[sub_resource type="Resource" id="Resource_7lplp"]
script = ExtResource("1_d4656")
id = "shop_cleanse"
topic = "shops"
term = "Cleanse"
text = "A shop service: throw away one rotten item for good."

[sub_resource type="Resource" id="Resource_05ddp"]
script = ExtResource("1_d4656")
id = "shop_upgrade"
topic = "shops"
term = "Upgrade"
text = "Pay to raise one backpack item by a level. At a campfire the same upgrade is free, but it is your one choice there."

[sub_resource type="Resource" id="Resource_nl2ya"]
script = ExtResource("1_d4656")
id = "shop_restock"
topic = "shops"
term = "Restock"
text = "Pay for fresh stock on the shelves. Each restock at the same shop costs more than the last."

[sub_resource type="Resource" id="Resource_1vr0v"]
script = ExtResource("1_d4656")
id = "camp_rest"
topic = "shops"
term = "Rest"
text = "Everyone heals half of their max HP. It works once, and it is the one choice you make at that fire."
icon_path = "res://assets/sprites/ui/map_rest.png"

[sub_resource type="Resource" id="Resource_42uva"]
script = ExtResource("1_d4656")
id = "camp_train"
topic = "shops"
term = "Train"
text = "Every hero gets one attribute point to spend."

[sub_resource type="Resource" id="Resource_j6wsn"]
script = ExtResource("1_d4656")
id = "event_choice"
topic = "shops"
term = "Event choices"
text = "A choice spells out its price and reward. Prices can be gold, max HP for good, a backpack item or a curse. Some carry a risk, and some start an ambush."
icon_path = "res://assets/sprites/ui/map_event.png"

[sub_resource type="Resource" id="Resource_t2qvb"]
script = ExtResource("1_d4656")
id = "spoils"
topic = "shops"
term = "Spoils"
text = "The prize after a guard, an elite or an act's boss: pick one of three pieces of gear, rare or better. One of the three is usually rot-touched."

[sub_resource type="Resource" id="Resource_2bmla"]
script = ExtResource("1_d4656")
id = "the_run"
topic = "run"
term = "The run"
text = "A road through the map to the last boss, over two acts: The Rotten Road and The Ashen Deep. If the whole party falls it is over. Only your oaths and Journal carry on."

[sub_resource type="Resource" id="Resource_oxqn7"]
script = ExtResource("1_d4656")
id = "oath"
topic = "run"
term = "Oath"
text = "A difficulty you pick before a run. Each oath adds a hardship to those before it and nothing ever makes the run easier. Win at Oath N to unlock N + 1."

[sub_resource type="Resource" id="Resource_voqww"]
script = ExtResource("1_d4656")
id = "oath_list"
topic = "run"
term = "The ten oaths"
text = "Thorns, Want, Embers, the Deep, Crowns, Wounds, Scarcity, Silence, the Long Road, Rot. The players screen lists what each one does."

[sub_resource type="Resource" id="Resource_ujnpq"]
script = ExtResource("1_d4656")
id = "gold"
topic = "run"
term = "Gold"
text = "Earned from fights and chests, spent in shops and at some shrines. Elites pay more, and the Oath of Want pays less."

[sub_resource type="Resource" id="Resource_uw7h0"]
script = ExtResource("1_d4656")
id = "level"
topic = "run"
term = "Level and XP"
text = "Each hero levels on their own from fights. A level gives attribute points, a skill point and a little HP and power."

[sub_resource type="Resource" id="Resource_d4ofk"]
script = ExtResource("1_d4656")
id = "attributes"
topic = "run"
term = "Attributes"
text = "Vitality raises max HP, Might power, Agility speed, Defense cuts enemy hits and Luck critical chance. Points can be taken back and a reset is free."

[sub_resource type="Resource" id="Resource_wvly6"]
script = ExtResource("1_d4656")
id = "hp_carries"
topic = "run"
term = "HP carries over"
text = "Health does not refill between fights. Campfires, shops and shrines are where you mend. Marks and AP start fresh each fight."

[sub_resource type="Resource" id="Resource_b30i1"]
script = ExtResource("1_d4656")
id = "save_quit"
topic = "run"
term = "Save and Quit"
text = "In the pause menu: keeps the run for later and goes to the main menu. Abandon run loses it for good."

[sub_resource type="Resource" id="Resource_dkefa"]
script = ExtResource("1_d4656")
id = "journal"
topic = "run"
term = "Rot Journal"
text = "In Extras: a book of every enemy and attack you meet in a run, with your record against each. Nothing in it changes a fight."

[sub_resource type="Resource" id="Resource_p25rush1"]
script = ExtResource("1_d4656")
id = "fight_rush"
topic = "rush"
term = "Fight Rush"
text = "Pick it under New Run: fight after fight, with no map, zones, shops or campfires. Each fight is harder, every 5th is an elite and every 10th a boss. HP carries over, there is no running away, and one loss ends it."
icon_path = "res://assets/sprites/ui/choice_rush.png"

[sub_resource type="Resource" id="Resource_p25rush2"]
script = ExtResource("1_d4656")
id = "rush_cards"
topic = "rush"
term = "Reward cards"
text = "After each win pick a card: Heal, Train (attribute points) or an item. After an elite or a boss, Relics take the item's place; they last for that Rush only. A boss win heals everyone fully. XP past level 10 earns extra picks."
icon_path = "res://assets/sprites/ui/choice_heal.png"

[sub_resource type="Resource" id="Resource_p25rush3"]
script = ExtResource("1_d4656")
id = "rush_records"
topic = "rush"
term = "Records"
text = "The furthest fight reached is kept for Solo, Duo and Trio, with its date. A friend who joins moves the Rush up a size. The New Run card shows the best. Nothing else goes back: Relics and Echo pips stay as they were."
tag = "NEW RECORD"
color = Color(1, 0.82, 0.3, 1)


[resource]
script = ExtResource("1_act")
id = "drowned_mire"
display_name = "The Drowned Mire"
zones = Array[ExtResource("4_zone")]([ExtResource("5_bog")])
final_encounter = ExtResource("6_queen")
final_look = ExtResource("7_lair")
final_map_icon_path = "res://assets/sprites/ui/map_lair_leech_queen.png"
elites = Array[ExtResource("2_enc")]([ExtResource("e_toad_court"), ExtResource("e_twin_husks")])
events = Array[ExtResource("3_event")]([ExtResource("v_weeping_well"), ExtResource("v_drowned_chapel"), ExtResource("v_black_mirror"), ExtResource("v_widows_wager"), ExtResource("v_healing_spring"), ExtResource("v_rot_blossom"), ExtResource("v_wounded_pilgrim"), ExtResource("v_merchant_wreck"), ExtResource("v_whispering_mask"), ExtResource("v_gamblers_bones")])
ambushes = Array[ExtResource("2_enc")]([ExtResource("a_toad_and_fly"), ExtResource("a_lantern_trio"), ExtResource("a_fly_pair"), ExtResource("a_tick_nest"), ExtResource("a_rat_pack"), ExtResource("a_husk_trio")])
ambush_picture_path = "res://assets/sprites/events/ambush_drowned_mire.png"
ambush_text = "The black water lay still around the mark on the map. It was not empty. Something in the Mire was waiting for you."

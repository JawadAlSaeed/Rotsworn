find_rarity = 1

[sub_resource type="Resource" id="Resource_grbyc"]
script = ExtResource("1_gr01")
text = "Buy what he dug up"
detail = "He swears it is rare."
deal = SubResource("Resource_grbuy")
done_text = "He hands it over, still wet with grave dirt."

[sub_resource type="Resource" id="Resource_grdig"]
script = ExtResource("2_gr02")
gold = 45
find_rarity = 0

[sub_resource type="Resource" id="Resource_grrsk"]
script = ExtResource("2_gr02")
ambush = ExtResource("3_gr03")

[sub_resource type="Resource" id="Resource_grdgc"]
script = ExtResource("1_gr01")
text = "Help him dig"
detail = "Half of what you find is yours. The dead may mind."
deal = SubResource("Resource_grdig")
risk_percent = 40
risk_deal = SubResource("Resource_grrsk")
done_text = "You split the take by lantern light."
risk_text = "The earth heaves. The dead climb out to stop you."

[resource]
script = ExtResource("4_gr04")
id = "grave_robber"
title = "The Grave Robber"
text = "A hooded man digs by lantern light, a sack at his feet. \"Fresh from the ground, friend. Buy, or keep walking.\""
picture_path = "res://assets/sprites/events/grave_robber.png"
choices = Array[ExtResource("1_gr01")]([SubResource("Resource_grbyc"), SubResource("Resource_grdgc")])

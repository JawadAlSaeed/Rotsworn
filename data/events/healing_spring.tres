[sub_resource type="Resource" id="Resource_hsfsc"]
script = ExtResource("1_hs01")
text = "Fish out the coins"
detail = "Others paid the spring. It may want them back."
deal = SubResource("Resource_hsfsh")
risk_percent = 50
risk_deal = SubResource("Resource_hsrsk")

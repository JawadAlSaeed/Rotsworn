risk_text = "The glow dims, and one of you feels it go out inside."

[resource]
script = ExtResource("3_hs03")
id = "healing_spring"
title = "The Healing Spring"
text = "Under a broken arch, a stone basin brims with water that glows like moonlight. Old coins shine on the bottom."
picture_path = "res://assets/sprites/events/healing_spring.png"

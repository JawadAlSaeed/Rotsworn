[gd_resource type="Resource" script_class="WorldPieceData" format=3]

[ext_resource type="Script" path="res://scripts/data/world_piece_data.gd" id="1_piece"]
[ext_resource type="Script" path="res://scripts/data/piece_surface_data.gd" id="2_surface"]

[sub_resource type="Resource" id="Resource_bark"]
script = ExtResource("2_surface")
name = "bark"
texture_path = "res://assets/sprites/env/bark.png"

[sub_resource type="Resource" id="Resource_rot"]
script = ExtResource("2_surface")
name = "rot"
texture_path = "res://assets/sprites/env/hollow_floor.png"

[resource]
script = ExtResource("1_piece")
id = "log"
model_path = "res://assets/models/log.glb"
surfaces = Array[ExtResource("2_surface")]([SubResource("Resource_bark"), SubResource("Resource_rot")])

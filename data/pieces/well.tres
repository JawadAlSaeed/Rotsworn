[gd_resource type="Resource" script_class="WorldPieceData" format=3]

[ext_resource type="Script" path="res://scripts/data/world_piece_data.gd" id="1_piece"]
[ext_resource type="Script" path="res://scripts/data/piece_surface_data.gd" id="2_surface"]

[sub_resource type="Resource" id="Resource_stone"]
script = ExtResource("2_surface")
name = "stone"
texture_path = "res://assets/sprites/env/ruin_wall.png"

[sub_resource type="Resource" id="Resource_wood"]
script = ExtResource("2_surface")
name = "wood"
texture_path = "res://assets/sprites/env/planks.png"

[sub_resource type="Resource" id="Resource_thatch"]
script = ExtResource("2_surface")
name = "thatch"
texture_path = "res://assets/sprites/env/thatch.png"

[resource]
script = ExtResource("1_piece")
id = "well"
model_path = "res://assets/models/well.glb"
surfaces = Array[ExtResource("2_surface")]([SubResource("Resource_stone"), SubResource("Resource_wood"), SubResource("Resource_thatch")])

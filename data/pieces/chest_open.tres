[gd_resource type="Resource" script_class="WorldPieceData" format=3]

[ext_resource type="Script" path="res://scripts/data/world_piece_data.gd" id="1_piece"]
[ext_resource type="Script" path="res://scripts/data/piece_surface_data.gd" id="2_surface"]

[sub_resource type="Resource" id="Resource_wood"]
script = ExtResource("2_surface")
name = "wood"
texture_path = "res://assets/sprites/env/planks.png"

[sub_resource type="Resource" id="Resource_iron"]
script = ExtResource("2_surface")
name = "iron"
texture_path = "res://assets/sprites/env/iron.png"

[sub_resource type="Resource" id="Resource_gold"]
script = ExtResource("2_surface")
name = "gold"
texture_path = "res://assets/sprites/env/gold.png"
glow = 1.2
glow_color = Color(1, 0.8, 0.4, 1)

[resource]
script = ExtResource("1_piece")
id = "chest_open"
model_path = "res://assets/models/chest_open.glb"
surfaces = Array[ExtResource("2_surface")]([SubResource("Resource_wood"), SubResource("Resource_iron"), SubResource("Resource_gold")])

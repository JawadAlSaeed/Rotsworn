class_name SpriteClips
extends Resource
## Frame layout of one fighter sheet (DESIGN.md 5.3 and 5.5): a grid of equal cells, `hframes`
## wide and `vframes` tall. Row 0 holds the legacy poses in the legacy order, so a pose is still a
## cell index; every named clip lists the cells it plays, in order. Generated by tools/art_kit
## together with the sheet (data/clips/<id>.tres); never edit by hand.

## One cell of the grid, in pixels.
@export var frame_size: Vector2i = Vector2i(48, 56)
@export_range(1, 64) var hframes: int = 8
@export_range(1, 512) var vframes: int = 1
## Body width in the old one-row frame (32 for heroes, the square for enemies): sizes the shadow.
@export var body_width_px: int = 32
## Clip name (always String, never StringName) -> sheet cells in play order. Repeats hold longer.
@export var clips: Dictionary = {}


## The cells of `clip` in play order (empty when the sheet has no such clip).
func frames(clip: String) -> PackedInt32Array:
	var value: Variant = clips.get(clip)
	if value is PackedInt32Array:
		return value
	if value is Array:
		return PackedInt32Array(value as Array)
	return PackedInt32Array()


## How many cells `clip` plays (0 = missing).
func count(clip: String) -> int:
	return frames(clip).size()


## Cells in the grid.
func cell_count() -> int:
	return hframes * vframes


## Size of the whole sheet in pixels.
func sheet_size() -> Vector2i:
	return Vector2i(frame_size.x * hframes, frame_size.y * vframes)


## True if `texture` is exactly this grid's size (anything else is shown as a legacy one-row sheet).
func matches(texture: Texture2D) -> bool:
	return texture != null and Vector2i(texture.get_width(), texture.get_height()) == sheet_size()


## Size in pixels of one frame of `texture` as FighterView shows it: the clips' cell when the
## texture matches them, otherwise a frame of the legacy one-row sheet of `hframes` frames.
@warning_ignore("integer_division")
static func frame_px(sprite_clips: SpriteClips, texture: Texture2D, hframes: int) -> Vector2i:
	if sprite_clips != null and sprite_clips.matches(texture):
		return sprite_clips.frame_size
	if texture == null:
		return sprite_clips.frame_size if sprite_clips != null else Vector2i.ZERO
	return Vector2i(texture.get_width() / maxi(1, hframes), texture.get_height())

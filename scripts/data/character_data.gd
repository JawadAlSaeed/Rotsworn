class_name CharacterData
extends Resource
## A playable character and their class kit (DESIGN.md 2.10).

## Unique id used in commands and save data.
@export var id: String = ""
@export var display_name: String = ""
## Accent colour for UI and placeholder tint.
@export var color: Color = Color.WHITE
## Battle sprite sheet: one row of equal frames in this order:
## idle, ready, parry, dodge, jump, hurt, strike, down (with sprite_clips: a grid whose row 0
## holds them in that order). Replace the file to change the art.
@export_file_path("*.png") var sprite_path: String = ""
## Number of frames in the sprite sheet row (the legacy one-row sheet; with sprite_clips it is
## still the number of legacy poses, 8, used when the sheet does not match the clips).
@export_range(1, 64) var sprite_hframes: int = 8
## Grid layout and animation clips of the sheet (data/clips/<id>.tres, generated by tools/art_kit;
## DESIGN.md 5.5). Empty: the legacy one-row sheet of sprite_hframes frames, one frame per pose.
@export var sprite_clips: SpriteClips
## Small square face for the timeline, the party panels and the party screen.
@export_file_path("*.png") var portrait_path: String = ""
## The big painted portrait on the players screen (cards #140, #141; made by
## tools/art_kit/portraits_from_pictures.py, which also cuts the small face from the same picture).
@export_file_path("*.png") var big_portrait_path: String = ""
## World units per sprite pixel (bigger = larger on screen).
@export_range(0.001, 0.2, 0.001) var sprite_pixel_size: float = 0.045
## HP, in percent of tuning base_character_hp.
@export_range(10, 1000, 5, "suffix:%") var hp_percent: int = 100
## Power (base damage), in percent of tuning base_party_damage.
@export_range(10, 1000, 5, "suffix:%") var power_percent: int = 100
## Turn speed. 100 is average; 200 acts twice as often as 100.
@export_range(1, 1000) var speed: int = 100
@export var basic_attack: AbilityData
@export var skills: Array[AbilityData] = []
## The hero's skill tree (card #136). Empty: no tree, the hero always has every skill in `skills`.
## With a tree, a run gives the hero the skills they unlocked and chose to bring (RunState); fights
## outside a run give them every skill.
@export var skill_tree: SkillTreeData
## Sound cue for a short shout when this hero uses a skill or joins the Team Ultimate (card #102).
@export var shout_sfx: String = ""


## The basic attack, then every skill (the list, then any tree skill not in it).
func all_abilities() -> Array[AbilityData]:
	var list: Array[AbilityData] = []
	if basic_attack != null:
		list.append(basic_attack)
	for skill: AbilityData in skills:
		if skill != null:
			list.append(skill)
	if skill_tree != null:
		for skill: AbilityData in skill_tree.all_skills():
			if not list.has(skill):
				list.append(skill)
	return list

class_name EnemyData
extends Resource
## An enemy type.

## How a beaten enemy with a death clip leaves the fight (DESIGN.md 5.5).
enum DeathStyle {
	## Rots away: the pixel dissolve starts during the death clip.
	ROT,
	## Bursts into sparks when the death clip ends, then vanishes quickly.
	BURST,
}

## How a single-target attack of this enemy picks its hero (DESIGN.md 2.3). Taunt always wins.
enum TargetRule {
	## Every standing hero is equally likely.
	RANDOM,
	## The more HP a hero is missing, the likelier (weight 100 + missing percent x bias / 100).
	WOUNDED,
	## The standing hero with the least HP gets the bias added on top of the base weight.
	LOWEST_HP,
	## Heroes under Exposed or Marked get the bias added (for future enemy debuffs).
	MARKED,
	## Anyone but the hero it hit last gets the bias added.
	AVOID_LAST,
}

## Unique id used in events and save data.
@export var id: String = ""
@export var display_name: String = ""
## Accent colour for UI and placeholder tint.
@export var color: Color = Color.WHITE
## Battle sprite sheet: one row of equal frames in this order:
## idle, windup, lunge, contact, hurt, slam (with sprite_clips: a grid whose row 0 holds them in
## that order). Replace the file to change the art.
@export_file_path("*.png") var sprite_path: String = ""
## Number of frames in the sprite sheet row (the legacy one-row sheet; with sprite_clips it is
## still the number of legacy poses, 6, used when the sheet does not match the clips).
@export_range(1, 64) var sprite_hframes: int = 6
## Grid layout and animation clips of the sheet (data/clips/<id>.tres, generated by tools/art_kit;
## DESIGN.md 5.5). Empty: the legacy one-row sheet of sprite_hframes frames, one frame per pose.
@export var sprite_clips: SpriteClips
## How it dies when its sheet has a death clip, and the colour of its dissolving edge (alpha 0 =
## combat_visuals death_edge_color).
@export var death_style: DeathStyle = DeathStyle.ROT
@export var death_color: Color = Color(0.0, 0.0, 0.0, 0.0)
## Its idle breathing cycle, in percent of combat_visuals enemy_idle_cycle_ms (gnats quicker,
## a bloat slower).
@export_range(10, 1000, 1, "suffix:%") var idle_cycle_percent: int = 100
## Small picture for the timeline.
@export_file_path("*.png") var portrait_path: String = ""
## World units per sprite pixel (bigger = larger on screen).
@export_range(0.001, 0.2, 0.001) var sprite_pixel_size: float = 0.05
## HP, in percent of tuning base_enemy_hp.
@export_range(10, 10000, 5, "suffix:%") var hp_percent: int = 100
## Power (damage per hit), in percent of tuning base_enemy_hit_damage.
@export_range(10, 1000, 5, "suffix:%") var power_percent: int = 100
## Turn speed. 100 is average; 200 acts twice as often as 100.
@export_range(1, 1000) var speed: int = 100
@export var attacks: Array[EnemyAttackData] = []
## Who it hunts with single-target attacks, and how hard (extra weight on top of 100 per hero).
@export var target_rule: TargetRule = TargetRule.RANDOM
@export_range(0, 1000, 1, "suffix:%") var target_bias_percent: int = 0
## Gold and XP the party gets for beating it in a run (DESIGN.md 8).
@export_range(0, 10000) var gold: int = 10
@export_range(0, 10000) var xp: int = 20
## Sound cue for its voice (card #101): when it starts an attack, and quieter and higher when hit.
@export var voice_sfx: String = ""
## Relics this enemy can drop when a run fight against it is won (DESIGN.md 8.17): one of them, by
## the tuning's relic_drop_percent chance per enemy beaten.
@export var relic_drops: Array[GearData] = []
## Its hits always take their forced kinds (AttackHitData.forced_kind, card #187), even in an
## ordinary fight: the deep variants. Elite, guard and boss fights use them anyway.
@export var forced_hits: bool = false

@export_group("Phase two (bosses)")
## When its HP drops to this percent of max HP or lower, it enters phase two: it attacks with
## phase_two_attacks at phase_two_speed. 0 = no phase two.
@export_range(0, 99, 1, "suffix:%") var phase_two_hp_percent: int = 0
@export var phase_two_attacks: Array[EnemyAttackData] = []
## Speed in phase two (0 = unchanged).
@export_range(0, 1000) var phase_two_speed: int = 0
## Its attacks' tempo in phase two, in percent of the fight's (card #188): lower = faster strings
## (0 or 100 = unchanged). The fight's floor (tuning attack_tempo_floor_percent) still holds.
@export_range(0, 100, 1, "suffix:%") var phase_two_tempo_percent: int = 0
## Shown as a banner when phase two starts.
@export var phase_two_text: String = ""


## Every attack this enemy can ever use: its own, then the phase-two-only ones (an attack in both
## lists once). The engine's lookup, the fight's presentation data and the practice keys all want
## this, so a phase-two-only attack is never missing its projectile, rock wave or animation.
func all_attacks() -> Array[EnemyAttackData]:
	var list: Array[EnemyAttackData] = []
	for attack: EnemyAttackData in attacks + phase_two_attacks:
		if attack != null and not list.has(attack):
			list.append(attack)
	return list

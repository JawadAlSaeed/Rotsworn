; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Rotsworn"
config/description="Co-op turn-based RPG roguelike."
config/version="0.19.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=480
config/icon="res://assets/branding/icon.png"
config/windows_native_icon="res://assets/branding/icon.ico"
boot_splash/show_image=false
boot_splash/bg_color=Color(0, 0, 0, 1)

[autoload]

Audio="*res://scripts/autoload/audio.gd"
UserSettings="*res://scripts/autoload/user_settings.gd"
Net="*res://scripts/autoload/net.gd"
Prompts="*res://scripts/autoload/button_prompts.gd"
Pointer="*res://scripts/autoload/mouse_cursor.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=3

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[importer_defaults]

texture={
"compress/mode": 0,
"detect_3d/compress_to": 0,
"mipmaps/generate": false
}
wav={
"compress/mode": 0
}
oggvorbisstr={
"loop": true
}

